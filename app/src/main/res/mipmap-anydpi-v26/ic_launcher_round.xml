<?xml version="1.0" encoding="utf-8"?>
<!--
    Ícono de la app: el logo de DEPORTSTOCK sobre negro. El primer plano (mipmap-*) deja el
    contenido dentro del círculo seguro de 66 dp, así el lanzador no corta el nombre con ninguna
    forma (círculo, cuadrado redondeado, gota). Sin capa monocromática: los íconos temáticos de
    Android 13 muestran el logo a color.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
